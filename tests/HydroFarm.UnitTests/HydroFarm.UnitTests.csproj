<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for services, validators and other logic with mocked dependencies. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- No unit tests exist until Phase 5; exit code 8 = "zero tests ran". Remove once tests are added. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HydroFarm.Application\HydroFarm.Application.csproj" />
    <ProjectReference Include="..\..\src\HydroFarm.Services\HydroFarm.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
