# Copy to .env.local for local overrides. Never put secrets here: everything prefixed
# with VITE_ is bundled into the public JavaScript.

# Public site URL, used for canonical and Open Graph URLs (no trailing slash).
VITE_SITE_URL=

# API base URL. Leave empty to call /api on the same origin (the dev server proxies it).
VITE_API_BASE_URL=

# Dev server only: where /api is proxied to (the HydroFarm.WebApi https profile).
API_PROXY_TARGET=https://localhost:7237
